#!/bin/sh
# ps5-session: the one session SDDM logs user steam into (ps5-session.desktop).
#
# gamescope-session-cachyos chooses the next session (game mode or Plasma) by
# writing "Session=..." to /etc/sddm.conf.d/zz-steamos-autologin.conf. SteamOS
# carries an SDDM that reads that file again at every login; stock SDDM reads
# its configuration once, at start, so "Switch to Desktop" ended in game mode
# again. This wrapper reads the file at every login and starts that session.
# Anything unknown or unreadable starts game mode.

CONF=/etc/sddm.conf.d/zz-steamos-autologin.conf
next=$(sed -n 's/^Session=//p' "$CONF" 2>/dev/null | tail -n 1)

case "$next" in
    plasma*)
        export XDG_CURRENT_DESKTOP=KDE
        export XDG_SESSION_DESKTOP=KDE
        export DESKTOP_SESSION=plasma
        exec /usr/lib/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
        ;;
esac

export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=gamescope
export DESKTOP_SESSION=gamescope-session
exec /usr/bin/start-gamescope-session
