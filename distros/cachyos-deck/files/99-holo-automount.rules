# Replaces jupiter-hw-support's 99-holo-automount.rules. The PS5 boots from a
# USB disk, so keep the automounter off it.

KERNEL!="mmcblk*|sd*",          GOTO="holo_automount_end"
# Match USB parents, not ID_BUS=usb: USB SSDs with ATA passthrough report ata.
KERNEL=="mmcblk*", GOTO="holo_automount_bus_ok"
KERNEL=="sd*", SUBSYSTEMS=="usb", GOTO="holo_automount_bus_ok"
GOTO="holo_automount_end"
LABEL="holo_automount_bus_ok"
ENV{ID_FS_USAGE}!="filesystem", GOTO="holo_automount_end"

# Skip this image's partitions and anything on the root disk.
ENV{ID_FS_LABEL}=="cachyos-deck|boot", GOTO="holo_automount_end"
PROGRAM=="/usr/local/lib/ps5-os-disk %k", GOTO="holo_automount_end"

# The service expects to be asynchronous and shouldn't block udev rules
ACTION=="add",    RUN+="/bin/systemd-run --no-block --collect /usr/lib/hwsupport/block-device-event.sh add %k"
ACTION=="remove", RUN+="/bin/systemd-run --no-block --collect /usr/lib/hwsupport/block-device-event.sh remove %k"

LABEL="holo_automount_end"
